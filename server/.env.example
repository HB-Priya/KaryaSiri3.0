MONGO_URI=mongodb://127.0.0.1:27017/karyasiri
JWT_SECRET=change_this_to_a_long_random_string
PORT=5000
CLIENT_URL=http://localhost:5173

# Career Mentor chatbot (optional but required for the chat widget to work).
# Uses Google Gemini — it has a genuinely free tier (no credit card) for
# text generation, unlike Anthropic/OpenAI which require a paid account.
#   1. Go to https://aistudio.google.com and sign in with any Google account.
#   2. Click "Get API key" -> "Create API key". No billing setup needed.
#   3. Paste it below.
# Without this key set, the chat widget shows a clear "not configured"
# message instead of erroring.
GEMINI_API_KEY=
# If Google renames/retires this model, check https://ai.google.dev/gemini-api/docs/models
# for the current free-tier model name and update this.
# If this model name stops working (Google regularly retires older Gemini
# models — gemini-2.0-flash was retired June 2026, for example), check
# https://ai.google.dev/gemini-api/docs/models for a current free-tier
# model name and put it here. As of writing, Gemini 2.5 models are also
# scheduled to retire 16 October 2026, so gemini-3.1-flash-lite (below) is
# the current safest pick.
GEMINI_MODEL=gemini-3.1-flash-lite

# Translation into Tamil, Telugu, Kannada, Malayalam and Konkani (optional
# but required for /api/translate and the "translate this" UI to work).
# Uses Bhashini — the Government of India's translation API for Indian
# languages (National Language Translation Mission). Requires an approved
# account:
#   1. Sign up at https://bhashini.gov.in and wait for approval.
#   2. Log in, open "My Profile".
#   3. Under API Key, click Generate.
#   4. Copy the User ID and API key it gives you into the two lines below.
# Without these set, /api/translate returns a clear "not configured" message
# instead of erroring — the rest of the site keeps working either way.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
